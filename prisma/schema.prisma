generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Cloud mirror of each student's career profile (XP, ELO rating, crowns,
// streaks, achievements). The local profile is the source of truth while
// playing; this mirror makes progress survive cleared browsers / new devices.
model CareerProfile {
  deviceId  String   @id
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
